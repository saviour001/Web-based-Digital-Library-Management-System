# Copy to .env (or set these in your hosting dashboard) and fill in real values.
# A long random secret protects sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database. Leave as-is for SQLite, or paste a Postgres URL from your host.
# (postgres:// URLs are auto-upgraded to postgresql:// for SQLAlchemy.)
DATABASE_URL=sqlite:///library.db

ADMIN_EMAIL=admin@fpnasarawa.edu.ng

# 0 = production (no debugger shown to users). Keep this 0 when hosting.
FLASK_DEBUG=0

# Set to 1 once the site is served over HTTPS so cookies are secure-only.
SESSION_COOKIE_SECURE=0

# Local port (most hosts inject their own PORT automatically).
PORT=5000
